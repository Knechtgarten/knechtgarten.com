# Verhindert, dass Browser die HTML-Tools zwischenspeichern - nach jedem
# Hochladen soll die neueste Version sofort (auch ohne Hard-Refresh) angezeigt
# werden. Nur fuer HTML relevant, andere Dateitypen (Bilder etc.) sind vom
# Caching nicht betroffen und duerfen normal gecacht werden.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
</IfModule>

# www.knechtgarten.com -> knechtgarten.com (dauerhaft). Sonst sind es fuer den
# Browser zwei verschiedene Seiten mit je eigenem Login - wer mal die eine,
# mal die andere Adresse oeffnet, muss sich immer wieder neu anmelden.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.knechtgarten\.com$ [NC]
  RewriteRule ^(.*)$ https://knechtgarten.com/$1 [R=301,L]

  # QR-Codes auf Maschinen-Etiketten: knechtgarten.com/g/17 -> Gerät 17 im Wissens-Tool.
  # Die kurze Adresse bleibt fest, auch wenn das Tool später umbenannt wird (nur diese Zeile anpassen).
  RewriteRule ^g/([0-9]+)/?$ /wissen-live-v1.html?qr=$1 [R=302,L]
</IfModule>
