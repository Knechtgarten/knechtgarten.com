{
  "manifest_version": 3,
  "name": "Knechtgarten",
  "version": "0.35.0",
  "description": "Knechtgarten-Helfer: KI-Suche Drive/Gmail, Kürzel, Zoll und Rechnungen aus PEAX, be-geo, Shop-Warenkorb für QR-Bestellung.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Knechtgarten"
  },
  "permissions": ["identity", "sidePanel", "storage", "tabs", "alarms", "scripting"],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://gmail.googleapis.com/*",
    "https://oalapdxinqlnzwxhyuzy.supabase.co/*",
    "https://app.peax.ch/*",
    "https://shop.aquasolar.ch/*",
    "https://shop.bteam.ch/*",
    "https://www.immerag.ch/*",
    "https://www.hgc.ch/*",
    "https://www.aqua-technik-shop.de/*",
    "https://webshop.midas-gmbh.de/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://app.peax.ch/*"],
      "js": ["peax-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://app.peax.ch/*"],
      "js": ["peax-zoll-main.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://app.peax.ch/*"],
      "js": ["peax-zoll.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://e-dec-web.ezv.admin.ch/edecZugangscodeGui/*"],
      "js": ["edec-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://be-geo.ch/*", "https://www.be-geo.ch/*"],
      "js": ["begeo-content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://knechtgarten.com/*", "https://www.knechtgarten.com/*"],
      "js": ["kg-seite.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["kuerzel-content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ]
}
