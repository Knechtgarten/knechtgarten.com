{
  "manifest_version": 3,
  "name": "Knechtgarten",
  "version": "0.28.0",
  "description": "Knechtgarten-Helfer: KI-Suche über Google Drive und Gmail, Kürzel wie /mwst in allen Eingabefeldern.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Knechtgarten"
  },
  "permissions": ["identity", "sidePanel", "storage", "tabs", "alarms"],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://gmail.googleapis.com/*",
    "https://oalapdxinqlnzwxhyuzy.supabase.co/*",
    "https://app.peax.ch/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://app.peax.ch/*"],
      "js": ["peax-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["kuerzel-content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ]
}
