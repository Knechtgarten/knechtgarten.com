{
  "manifest_version": 3,
  "name": "Knechtgarten Dokumenten-Suche",
  "version": "0.12.0",
  "description": "KI-gestützte Suche über Google Drive und Gmail.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Dokumenten-Suche"
  },
  "permissions": ["identity", "sidePanel", "storage", "tabs"],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://gmail.googleapis.com/*",
    "https://oalapdxinqlnzwxhyuzy.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
